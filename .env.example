# Copie este arquivo para ".env" e preencha com os dados do SEU projeto Supabase.
# Você encontra esses valores em: Supabase > Project Settings > Data API / API Keys
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Use a chave PUBLICÁVEL (sb_publishable_...) ou a "anon public" (eyJ...).
# NUNCA a sb_secret_... — ela ignora as regras de segurança do banco.
VITE_SUPABASE_ANON_KEY=sua-chave-publicavel-aqui
